# Generic example only; not a production configuration.
serverAddr = "203.0.113.10"
serverPort = 7000
loginFailExit = false
auth.method = "token"
auth.additionalScopes = ["HeartBeats", "NewWorkConns"]
auth.tokenSource.type = "file"
auth.tokenSource.file.path = "/etc/frp/token"
transport.tls.enable = true
transport.tls.serverName = "frp.example.internal"
transport.tls.certFile = "/etc/frp/tls/client.crt"
transport.tls.keyFile = "/etc/frp/tls/client.key"
transport.tls.trustedCaFile = "/etc/frp/tls/ca.crt"
log.to = "console"
log.level = "info"
[[proxies]]
name = "example-http"
type = "tcp"
localIP = "127.0.0.1"
localPort = 8080
remotePort = 18080
