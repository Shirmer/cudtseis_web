# Team shared frontend development config for the cloud backend.
# Copy this file to Project-Code/Frontend/quakes-frontend/.env.local.
#
# If each developer runs only the frontend locally, call the cloud backend directly.
VITE_API_BASE=http://8.137.179.31:8001/api

# If you run a local backend again, switch VITE_API_BASE back to /api and use this proxy.
VITE_PROXY_TARGET=http://127.0.0.1:8001
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=5173
