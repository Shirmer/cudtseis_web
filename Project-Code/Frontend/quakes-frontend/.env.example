# Empty means same-origin /api, recommended behind Nginx.
VITE_API_BASE=

# For local development without Vite proxy, you can use:
# VITE_API_BASE=http://127.0.0.1:8001

# Optional: configure a Tianditu browser key for its official labeled basemap.
# Without a key, the catalog uses NASA Earthdata's open Blue Marble natural
# imagery. It contains no political borders or country labels and needs no key.
VITE_TIANDITU_TOKEN=

# When Tianditu is enabled, fill in its current map approval number.
VITE_MAP_APPROVAL_NO=
