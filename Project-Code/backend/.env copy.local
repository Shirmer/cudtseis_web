# Local secrets and model settings. Do not commit this file.
OPENAI_API_KEY=REMOVED_SENSITIVE_VALUE
OPENAI_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
GEO_RAG_CHAT_MODEL=doubao-seed-2-0-lite-260215
RAGANYTHING_LLM_MODEL=doubao-seed-2-0-lite-260215

# Doubao Seed is used for chat/reasoning only.
# Geo RAG embeddings are configured separately below.
OPENAI_EMBEDDING_MODEL=

# Shared test database and vector store.
# Fill these two placeholders before running the backend.
DATABASE_URL=postgresql+psycopg://cudtseis:REMOVED_SENSITIVE_VALUE@8.137.179.31:5432/quakes
QDRANT_URL=http://8.137.179.31:6333
QDRANT_API_KEY=REMOVED_SENSITIVE_VALUE
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Geo RAG v2 embedding and remote vector store.
GEO_RAG_EMBEDDING_PROVIDER=http
GEO_RAG_EMBEDDING_URL=https://api.siliconflow.cn/v1/embeddings
GEO_RAG_EMBEDDING_API_KEY=REMOVED_SENSITIVE_VALUE
GEO_RAG_EMBEDDING_ALLOW_FALLBACK=false
GEO_RAG_EMBEDDING_MODEL=BAAI/bge-m3
GEO_RAG_EMBEDDING_DIM=1024
GEO_RAG_EMBEDDING_BATCH_SIZE=32
GEO_RAG_INDEX_VERSION=geo-rag-bge-m3-v1
QDRANT_COLLECTION=geo_knowledge_bge_m3_v1
QDRANT_USE_LOCAL=false
QDRANT_LOCAL_PATH=./.data/qdrant-local
