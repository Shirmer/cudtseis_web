# Team shared server-backend config.
# Copy this file to Project-Code/backend/.env.local on the cloud server, then fill the placeholders.
#
# PostgreSQL/PostGIS runs on the same cloud server/container host as the backend.
# Prefer 127.0.0.1 here so the backend does not depend on the public database port.
DATABASE_URL=postgresql+psycopg://cudtseis:REPLACE_WITH_POSTGRES_PASSWORD@127.0.0.1:5432/quakes

SQL_ECHO=false
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://8.137.179.31,http://8.137.179.31:5173
USGS_BASE=https://earthquake.usgs.gov/fdsnws/event/1/query
POLL_SECONDS=60
MIN_MAGNITUDE=3.0
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8001

# Doubao/Ark chat model for AI reasoning.
OPENAI_API_KEY=REPLACE_WITH_DOUBAO_API_KEY
OPENAI_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
GEO_RAG_CHAT_MODEL=doubao-seed-2-0-lite-260215
RAGANYTHING_LLM_MODEL=doubao-seed-2-0-lite-260215

# Doubao chat is used for generation only.
# Keep this empty because embeddings come from the dedicated TEI endpoint below.
OPENAI_EMBEDDING_MODEL=

# Qdrant runs on the same cloud server/container host as the backend.
QDRANT_USE_LOCAL=false
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=REPLACE_WITH_QDRANT_API_KEY
QDRANT_COLLECTION=geo_knowledge_bge_m3_v1
QDRANT_LOCAL_PATH=./.data/qdrant-local

# Geo RAG embedding provider.
# Run TEI on the cloud server or set this to another URL the server can reach.
# Leave the API key empty unless you later add auth in front of TEI.
GEO_RAG_EMBEDDING_PROVIDER=http
GEO_RAG_EMBEDDING_URL=http://127.0.0.1:8080/v1/embeddings
GEO_RAG_EMBEDDING_API_KEY=
GEO_RAG_EMBEDDING_ALLOW_FALLBACK=false
GEO_RAG_EMBEDDING_MODEL=BAAI/bge-m3
GEO_RAG_EMBEDDING_DIM=1024
GEO_RAG_EMBEDDING_BATCH_SIZE=32
GEO_RAG_INDEX_VERSION=geo-rag-bge-m3-v1

GEO_RAG_CHUNK_CHARS=1200
GEO_RAG_CHUNK_OVERLAP=180

# PDF/TXT/MD originals. Because the backend runs on the cloud server, local means
# "server local directory", not a developer laptop.
GEO_RAG_STORAGE_BACKEND=local
GEO_RAG_STORAGE_ROOT=/opt/cudtseis_web/storage/geo_rag_documents
GEO_RAG_UPLOAD_STAGE_ROOT=/opt/cudtseis_web/storage/geo_rag_upload_stage
GEO_RAG_STORAGE_REMOTE_ROOT=/opt/cudtseis_web/storage/geo_rag_documents
GEO_RAG_STORAGE_PUBLIC_BASE_URL=http://8.137.179.31/files/geo_rag_documents
GEO_RAG_STORAGE_SSH_HOST=
GEO_RAG_STORAGE_SSH_USER=root
GEO_RAG_STORAGE_SSH_PORT=22
GEO_RAG_STORAGE_SSH_KEY_PATH=
GEO_RAG_FALLBACK_STORE_PATH=/opt/cudtseis_web/storage/geo_rag_vector_fallback.json
