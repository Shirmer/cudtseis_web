# Copy this file to .env for local development.
# macOS/Homebrew often works without user/password when your local PostgreSQL
# role matches your system user. This form uses the local PostgreSQL socket and
# does not include any team member's username or password:
DATABASE_URL=postgresql+psycopg:///quakes

# Windows PostgreSQL installers commonly create a postgres user with a password.
# Use this form if your local database requires credentials:
# DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@127.0.0.1:5432/quakes

SQL_ECHO=false
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
USGS_BASE=https://earthquake.usgs.gov/fdsnws/event/1/query
POLL_SECONDS=60
MIN_MAGNITUDE=3.0

# Optional literature/RAG integrations.
SEMANTIC_SCHOLAR_API_KEY=
OPENALEX_EMAIL=
RAG_TOP_K=6
RAG_VECTOR_DIMENSIONS=256
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# If your chat model provider does not expose an embeddings endpoint, leave
# OPENAI_EMBEDDING_MODEL empty so the MVP uses local hash embeddings:
# OPENAI_EMBEDDING_MODEL=

# Optional real RAGAnything integration for full-document/multimodal ingestion.
# Install dependencies first, then set RAGANYTHING_ENABLED=true.
RAGANYTHING_ENABLED=false
RAGANYTHING_WORKING_DIR=./.data/raganything
RAGANYTHING_OUTPUT_DIR=./.data/raganything_output
RAGANYTHING_DOCUMENT_DIR=./.data/documents
RAGANYTHING_PARSER=mineru
RAGANYTHING_PARSE_METHOD=auto
RAGANYTHING_QUERY_MODE=hybrid
RAGANYTHING_LLM_MODEL=gpt-4o-mini
RAGANYTHING_VISION_MODEL=gpt-4o
RAGANYTHING_EMBEDDING_DIM=1536
RAGANYTHING_MAX_TOKEN_SIZE=8192
RAGANYTHING_ENABLE_IMAGE_PROCESSING=true
RAGANYTHING_ENABLE_TABLE_PROCESSING=true
RAGANYTHING_ENABLE_EQUATION_PROCESSING=true

# MVP geology literature knowledge base.
# Qdrant is recommended for team/dev parity. If it is not running, the backend
# still starts and uses a local JSON fallback store for small-scale development.
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=geo_knowledge_v1
QDRANT_USE_LOCAL=false
QDRANT_LOCAL_PATH=./.data/qdrant-local
GEO_RAG_CHAT_MODEL=gpt-4o-mini
GEO_RAG_INDEX_VERSION=geo-rag-v1
GEO_RAG_EMBEDDING_PROVIDER=auto
GEO_RAG_EMBEDDING_MODEL=
GEO_RAG_EMBEDDING_DIM=1536
GEO_RAG_EMBEDDING_BATCH_SIZE=32
GEO_RAG_CHUNK_CHARS=1200
GEO_RAG_CHUNK_OVERLAP=180
GEO_RAG_STORAGE_ROOT=./.data/geo_rag_documents
GEO_RAG_FALLBACK_STORE_PATH=./.data/geo_rag_vector_fallback.json

# Optional VikingDB embedding provider for bge-m3.
VIKINGDB_AK=
VIKINGDB_SK=
VIKINGDB_HOST=api-vikingdb.volces.com
VIKINGDB_REGION=cn-beijing
